{
  "schemaVersion": 1,
  "id": "better_than_datapacks",
  "version": "${version}",

	"name": "Better than datapacks",
	"description": "This mod aims to help map-makers.",
  "authors": [
    "@Garkatron"
  ],
  "contact": {
    "homepage": "https://garkatronics-mc.github.io/BTA-AtomsEditor/",
    "sources": "https://github.com/Garkatronics-MC/BTA-Atoms"
  },

	"icon": "icon.png",
  "license": "CC0-1.0",

  "environment": "*",
  "entrypoints": {
